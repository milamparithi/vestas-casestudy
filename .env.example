# Provider-agnostic LLM settings (litellm model string).
# Any provider that litellm supports works, e.g.:
#   LLM_MODEL=gemini/gemini-2.5-flash
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=anthropic/claude-sonnet-4
#   LLM_MODEL=ollama/llama3
LLM_MODEL=

# API key for the chosen provider (not needed for local models).
LLM_API_KEY=

# Optional: custom OpenAI-compatible endpoint, e.g. LM Studio or vLLM.
# LLM_BASE_URL=http://localhost:1234/v1

# Optional: seconds to pause before each LLM call, to stay under provider rate
# limits. Useful on free tiers (e.g. 4 for Gemini's 15 requests/minute).
# LLM_REQUEST_DELAY=4
